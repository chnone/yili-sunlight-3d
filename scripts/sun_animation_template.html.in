}
function pathPoly(poly,P,z=0){
 let path=new Path2D();poly.forEach(([x,y],i)=>{const [a,b]=P(x,y,z);if(i===0)path.moveTo(a,b);else path.lineTo(a,b)});path.closePath();return path;
}
function paint(path,fill,stroke,width=1){if(fill){g.fillStyle=fill;g.fill(path)}if(stroke){g.strokeStyle=stroke;g.lineWidth=width;g.stroke(path)}}
function textAt(txt,x,y,size,col,align='center',bold=false,halo=false){
 g.font=(bold?'600 ':'')+size+'px "PingFang SC","Microsoft YaHei",sans-serif';g.textAlign=align;g.textBaseline='middle';
 if(halo){g.strokeStyle='#f5f7f3';g.lineWidth=2.8;g.lineJoin='round';g.strokeText(txt,x,y)}g.fillStyle=col;g.fillText(txt,x,y)
