<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>一里南侧地块 · 三维日照回放</title>
<style>
:root{color-scheme:light;--ink:#193542;--dim:#4a646c;--line:#d2dcd9;--page:#f4f5f1;--card:#fff;--sky:#e8eeed;--sun:#ffc35d;--amber:#905816;--shade:#576b75;--blue:#214e61;--tint:#eef3f2;font-family:"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",system-ui,sans-serif;color:var(--ink);background:var(--page)}
*{box-sizing:border-box}body{margin:0}button,select,input{font:inherit}button,select{color:var(--ink)}button{cursor:pointer}button:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #cd8527;outline-offset:3px}button:disabled{opacity:.5;cursor:not-allowed}.wrap{max-width:1512px;margin:auto;padding:clamp(14px,2.6vw,42px)}
header{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:0 0 20px}h1,h2,p{margin:0}h1{font-size:clamp(26px,2.7vw,40px);line-height:1.25;font-weight:650;letter-spacing:-.06em}header p{font-size:13px;color:var(--dim);margin-top:8px}.tabs,.switch{display:inline-flex;padding:3px;gap:2px;border:1px solid var(--line);background:#f1f4f0;border-radius:7px}.tabs button,.switch button{font-size:13px;font-weight:570;background:transparent;border:0;border-radius:4px;min-height:32px;padding:4px 13px;white-space:nowrap}.tabs button[aria-pressed=true],.switch button[aria-pressed=true]{color:white;background:var(--blue)}
.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(270px,306px);gap:16px;align-items:start}.panel{background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}.map-head{padding:13px 17px;display:flex;justify-content:space-between;align-items:center;gap:12px}.mode{display:flex;gap:7px}.map-head h2,.side h2{font-size:16px;letter-spacing:.02em}.map-head .switch button{min-height:27px;padding:2px 8px;font-size:12px}.mapbox{position:relative;isolation:isolate;background:#edf1ef;border-block:1px solid #dce3df}.mapbox canvas{width:100%;height:auto;aspect-ratio:1.88;display:block;touch-action:pan-y;cursor:pointer}.compass{position:absolute;right:12px;top:11px;pointer-events:none;background:#fffefcef;border:1px solid #c5d0ca;border-radius:6px;padding:4px 8px;font-size:11px;color:#365460;display:flex;align-items:center;gap:5px}.compass svg{width:15px;height:24px;overflow:visible}.mapinfo{padding:9px 16px;display:flex;align-items:center;gap:8px 15px;flex-wrap:wrap;color:var(--dim);font-size:11px}.legend{display:inline-flex;align-items:center;gap:5px}.dot{width:10px;height:10px;border-radius:100%;border:1px solid #543d20;background:#ffbd4f}.dot.dark{border-color:#f1f4f3;background:#394e5d;box-shadow:0 0 0 1px #a6b5b7}.shadow-swatch{background:#aabbba;width:13px;height:7px;border-radius:2px}.mapnote{margin-left:auto}.transport{border-top:1px solid var(--line);padding:14px 17px 12px}.playline{display:flex;align-items:center;gap:12px}.play{padding:6px 14px;border:0;background:var(--blue);color:white;border-radius:5px;font-weight:600;min-width:80px;min-height:36px}.play .icon{display:inline-block;min-width:18px;text-align:left}.time{font-family:"SFMono-Regular","Menlo","Consolas",monospace;font-variant-numeric:tabular-nums;font-size:clamp(18px,2.1vw,29px);letter-spacing:-.055em;white-space:nowrap}.zone{color:var(--dim);font-size:11px}.speed{margin-left:auto;min-height:32px;padding:0 4px;border:1px solid var(--line);border-radius:4px;background:#fff}.slider{margin:11px 0 1px;width:100%;accent-color:var(--blue);cursor:pointer}.ticks,.timescale{display:flex;justify-content:space-between;color:var(--dim);font:11px/1.4 ui-monospace,monospace}.skyinfo{border-top:1px solid var(--line);padding:10px 17px;font-size:12px;color:var(--dim);display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}.skyinfo b{color:var(--ink)}
.side{padding:18px 16px}.fieldrow{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;margin:16px 0 8px}.side label{display:block;color:var(--dim);font-size:12px}.side select{display:block;width:100%;padding:6px 5px;margin:4px 0 0;background:white;border:1px solid #b5c5c4;border-radius:4px;min-height:36px;font-size:14px}.side label.wide{margin-bottom:16px}.probes-head{border-top:1px solid var(--line);padding-top:14px;display:flex;align-items:center;justify-content:space-between;gap:8px}.probes-head h2{font-size:15px}.probes-head small{color:var(--dim);font-size:10px;text-align:right}.probe{padding:12px 0;border-bottom:1px solid var(--line)}.probe-title,.duration{display:flex;align-items:center;justify-content:space-between;gap:8px}.probe-title strong{font-size:15px}.status{font-size:11px;font-weight:600;padding:3px 7px;border-radius:3px}.on{background:#fff0ce;color:#7c4c12}.off{background:#e8edee;color:#435a66}.duration{font-size:12px;color:var(--dim);margin:9px 0 5px}.duration b{font-size:13px;color:var(--ink);font-variant-numeric:tabular-nums}.track{position:relative;height:9px;background:#83929a;overflow:visible;border-radius:2px}.track .lit{position:absolute;background:#ffbc4d;height:100%}.track .cursor{position:absolute;top:-2px;bottom:-2px;width:2px;background:#182d38;box-shadow:0 0 0 1px #fffe}.periods{font-size:11px;line-height:1.55;color:var(--dim);margin-top:9px;overflow-wrap:anywhere}.timescale{margin-top:4px;font-size:10px}.meta{font-size:11px;color:var(--dim);line-height:1.6;margin-top:14px}
details{margin-top:14px;border-top:1px solid var(--line);padding-top:10px;color:var(--dim);font-size:12px;line-height:1.65}summary{cursor:pointer;color:var(--ink);font-weight:600}details p{margin-top:5px}.hint{font-size:11px;color:var(--dim);margin-top:9px}.alert{padding:20px;color:#911}
@media(max-width:900px){.grid{grid-template-columns:minmax(0,1fr) 242px;gap:10px}.map-head{padding:10px}.mapbox canvas{aspect-ratio:1.55}.wrap{padding:14px}.side{padding:13px}.zone{display:none}.transport{padding:12px}.tabs button{padding:4px 10px}.mapnote{margin:0}.mapinfo{padding:8px 10px}}
@media(max-width:680px){header{align-items:flex-start;flex-wrap:wrap;gap:11px;margin-bottom:12px}.grid{grid-template-columns:1fr}.mapbox canvas{aspect-ratio:1.32}.map-head{gap:5px}.map-head h2{font-size:14px}.map-head .switch button{padding:2px 6px}.mode{gap:4px}.side{padding:16px}.fieldrow{margin-top:10px}.time{font-size:20px}.playline{gap:9px}.ticks{font-size:10px}.side label.wide{margin-bottom:12px}.compass{right:6px;top:6px}.skyinfo{font-size:11px;padding:8px 10px}.hint{font-size:10px}}
 
.mapbox canvas{touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none;aspect-ratio:1.72}
.mapbox canvas.dragging{cursor:grabbing}.maptools{position:absolute;right:12px;bottom:12px;display:flex;gap:2px;border-radius:6px;border:1px solid #bfcac5;overflow:hidden;background:#fcfdf8ed}
.maptools button{border:0;background:transparent;padding:4px 9px;color:#284c58;font-size:16px;min-height:31px}
.maptools button:last-child{font-size:12px;border-left:1px solid #d4ddd8}.maphint{font-size:11px;color:var(--dim);background:#f6f8f4;padding:6px 16px}
#hover{position:absolute;pointer-events:none;background:#193c46ef;color:white;border-radius:4px;font-size:12px;padding:5px 8px;max-width:230px}
.side-tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:13px}.side-tabs button{padding:6px 10px;border:0;border-radius:4px;color:var(--dim);background:transparent;font-size:14px;font-weight:600}.side-tabs [aria-pressed=true]{color:var(--ink);background:#e5eeeb}
#externalPanel label{font-size:12px}.external-head{display:flex;gap:6px;align-items:center;margin:18px 0 12px;color:var(--ink)}.external-head h2{font-size:17px}.external-head small{margin-left:auto;color:var(--dim)}.external-height{font-size:16px;line-height:1.6;color:#244751;font-weight:650}.external-copy{font-size:12px;line-height:1.75;color:var(--dim);margin-top:9px;overflow-wrap:anywhere}.external-copy a{color:#176373}.blocker{font-size:11px;line-height:1.5;color:var(--dim);margin-top:7px}.blocker button{font-size:11px;line-height:1.5;padding:1px 4px;margin-left:2px;border-radius:3px;border:1px solid #becdc7;color:#24525d;background:#f3f7f3;text-align:left}.external-actions{display:flex;gap:6px;margin:13px 0}.external-actions button{background:#e6eeeb;border:1px solid #c5d4ce;padding:5px 10px;border-radius:4px;color:#254e59}.key{width:13px;height:9px;background:#afa49b;border:1px solid #83928b;border-radius:2px}.key.model{background:#82a6a6}.key.hit{background:#bf9a7b}.key.ext{background:#b4beb9}.mapinfo{gap:7px 11px}
@media(max-width:680px){.mapbox canvas{aspect-ratio:1.15}.maphint{font-size:10px;padding:7px 10px}.maptools{right:6px;bottom:7px}.maptools button{min-height:29px;padding:3px 8px}.mapnote{width:100%}}
#ticks{display:block;position:relative;height:19px}#ticks span{position:absolute;transform:translateX(-50%);white-space:nowrap}#ticks .first{transform:none}#ticks .last{transform:translateX(-100%)}.track .cursor{transform:translateX(-50%)}.skyinfo{font-variant-numeric:tabular-nums}.time{min-width:8ch}
#map{position:relative;z-index:1}.mapbox canvas.scene-layer,.mapbox canvas.bearing{position:absolute;top:0;left:0;width:100%;height:100%;aspect-ratio:auto;pointer-events:none;touch-action:auto;cursor:default}
.mapbox canvas.bearing{width:72px;height:64px;z-index:6}.mapbox canvas[hidden]{display:none}
.compass,.maptools,#hover{z-index:7}
.transport{container-type:inline-size}
@container(max-width:490px){#ticks .intermediate{display:none}}
.day-nav{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.rank-link{color:var(--blue);font-size:13px;text-underline-offset:3px}
.door-fields{margin:8px 0 16px}.door-fields select:disabled{opacity:1;color:var(--ink);background:#f2f5f3}
.day-results{grid-column:1 / -1}.day-results>details{margin:0;padding:12px 17px}
#rankings{padding:17px;scroll-margin-top:12px}#rankings h2{font-size:17px}
#rankSummary{margin:8px 0 3px;font-size:14px;line-height:1.6;color:var(--ink)}#rankHomes,.rank-method{font-size:12px;line-height:1.6;color:var(--dim)}
#rankList{list-style:none;padding:0;margin:12px 0 0;border-top:1px solid var(--line)}
.rank-home{display:grid;grid-template-columns:3.7em minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;padding:9px 3px;text-align:left;background:transparent;border:0;border-bottom:1px solid var(--line);font-size:13px}
.rank-home:hover,.rank-home[aria-pressed=true]{background:#edf4f1}.rank-home:focus-visible{outline-offset:-2px}.rank-number,.rank-phase,.rank-probes{color:var(--dim);font-size:11px}.rank-number{white-space:nowrap}.rank-home strong,.rank-home small{display:block}.rank-probes{text-align:right;margin-top:2px}.rank-duration{text-align:right;font-variant-numeric:tabular-nums}
#rankMore{margin-top:10px;padding:6px 10px;color:var(--blue);background:#f4f7f5;border:1px solid var(--line);border-radius:4px;font-size:12px}.rank-method{margin-top:9px}
@media(max-width:450px){#rankings{padding:12px}.rank-home{grid-template-columns:3.2em minmax(0,1fr) auto;gap:4px}.rank-home strong{font-size:12px}.day-nav{gap:10px}}
.bridge-link{padding:3px 0;border:0;background:transparent;color:#495579;font:inherit;text-decoration:underline;text-underline-offset:2px}.bridge-link[hidden]{display:none}.key.bridge{width:17px;height:8px;border:0;border-top:3px solid #646e89;border-radius:0;background:linear-gradient(to right,transparent 15%,#646e89 15% 30%,transparent 30% 70%,#646e89 70% 85%,transparent 85%)}
</style></head>
<body><main class="wrap">
<header><div><h1>一里南侧地块三维日照回放</h1><p id="subtitle">天津河西 · 南向窗台直射</p></div><div class="day-nav"><div id="dayTabs" class="tabs" role="group" aria-label="日期"></div><a class="rank-link" href="#rankings">看住户排行 ↓</a></div></header>
<div class="grid">
<section class="panel" aria-label="动画与播放控制">
<div class="map-head"><h2>楼群与阴影</h2><div class="mode"><div class="switch" role="group" aria-label="视角"><button data-view="iso" aria-pressed="true">三维</button><button data-view="plan" aria-pressed="false">俯视</button></div><div class="switch" role="group" aria-label="范围"><button data-scope="site" aria-pressed="true">地块</button><button data-scope="all" aria-pressed="false">含周边</button></div></div></div>
<div class="mapbox"><canvas id="map" tabindex="0" aria-label="三维日照模型，可拖动和缩放。方向键旋转，按住 Shift 平移，加减号缩放，Home 复位" aria-describedby="mapHint"></canvas><span id="hover" hidden></span><div class="compass"><svg viewBox="0 0 16 26" aria-hidden="true"><g id="north"><path d="M8 2 L13 20 L8 17 L3 20 Z" fill="#34535f"/><path d="M8 2 L8 17 L3 20 Z" fill="#a9b7ba"/></g></svg>北</div><div class="maptools" aria-label="相机控制"><button id="zoomOut" aria-label="缩小">−</button><button id="zoomIn" aria-label="放大">＋</button><button id="resetCam">复位</button></div></div>
<div id="mapHint" class="maphint"></div>
<div class="mapinfo"><span class="legend"><i class="key model"></i>住宅</span><span class="legend"><i class="key hit"></i>当日遮挡窗台的周边楼</span><span class="legend"><i class="key ext"></i>其他周边楼</span><button hidden type="button" id="bridgeLink" class="legend bridge-link" title="在三维图中查看西侧立交桥及模型尺寸"><i class="key bridge" aria-hidden="true"></i>西侧立交桥</button><span class="legend"><i class="dot"></i>窗台见光</span><span class="legend"><i class="dot dark"></i>窗台受遮</span><span class="legend"><i class="shadow-swatch"></i>阴影</span><span id="planeNote" class="mapnote"></span></div>
<div class="transport"><div class="playline"><button id="play" class="play"></button><strong class="time" id="clock"></strong><span class="zone">北京时间</span><select id="speed" class="speed" aria-label="播放倍速"><option value=".5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option></select></div><input id="scrub" class="slider" type="range" min="0" step="any" value="0" aria-label="日出至日落回放时间"><div class="ticks" id="ticks"></div></div>
<div class="skyinfo"><span>太阳高度 <b id="alt"></b>　方位 <b id="az"></b></span><span id="sampleTime"></span></div>
</section>
<aside class="panel side"><div class="side-tabs" role="group" aria-label="观察对象"><button id="homesTab" aria-pressed="true">住宅窗台</button><button id="externalsTab" aria-pressed="false">周边楼高</button></div><div id="homePanel"><h2>观察住宅</h2><div class="fieldrow"><label>楼栋<select id="house"></select></label><label>住宅楼层<select id="floor"></select></label></div>
<div class="fieldrow door-fields"><label>单元<select id="entry"></select></label><label>单元内户位<select id="unit"></select></label></div>
<div class="probes-head"><h2>南窗测点</h2><small id="until"></small></div><div id="probes"></div><p class="meta" id="homeMeta"></p><div class="external-actions"><button id="focusHome">聚焦这栋住宅</button></div></div>
<div id="externalPanel" hidden><label>周边建筑与设施<select id="external"></select></label><div class="external-head"><h2 id="extName"></h2><small id="extId"></small></div><div class="external-height" id="extHeight"></div><p class="external-copy" id="extSpan"></p><p class="external-copy" id="extReview"></p><div class="external-copy" id="extSource"></div><p class="external-copy" id="extImpact"></p><div class="external-actions"><button id="focusExt">聚焦这栋建筑</button></div></div>
</aside>
<div class="panel day-results">
<section id="rankings" aria-labelledby="rankTitle">
<h2 id="rankTitle">全天日照最长的住户</h2><p id="rankSummary"></p><p id="rankHomes"></p>
<ol id="rankList" aria-label="住户日照排行"></ol>
<button id="rankMore" type="button" aria-controls="rankList" aria-expanded="false" hidden></button>
<p class="rank-method">从日出算到日落，按每户各南窗测点的平均直射时长排名。点击一户可在三维图中查看。</p>
</section>
<details><summary>计算口径</summary><p>时间轴从当地日出播到日落，均为北京时间。太阳方向和楼影连续移动。窗台见光与遮挡按 5 分钟区间的中点射线判定，日出、日落附近的短区间单独采样。金色时段为模型直射时间。日出、日落按太阳上边缘升过或落到地平线的时刻计算；窗台射线指向太阳中心。太阳很低时，模型以外的远处建筑也可能挡光。</p><p>住宅首层从首个模型住宅层起算。主方案的窄楼只有一个单元，宽楼从东向西分成东单元和西单元。每个单元分东户和西户，每户南窗 A 点偏东、B 点偏西。分户边界与窗位按面宽推估。周边建筑和立交桥的建模高度与来源可在周边面板查看。</p><p>俯视阴影取所选楼层窗台标高，点色取各栋实际窗台的射线结果。三维模型按实际米制尺寸绘制，并随视角更新楼面遮挡与窗台可见性。周边楼按当前节气是否遮挡过住宅窗台着色。当一条射线遇到多个遮挡物时，面板显示最靠近窗台的一个。</p></details></div>
</div><p class="hint">底图采用 2026 年 11 月 2 日一期方案公示。后续分期楼位按图示计入。点住宅或窗台可选择观察户，点周边建筑或设施可核对高度和资料来源。</p>
</main>
<script type="application/json" id="scene">
__SUN_SCENE__
</script>
<script>
__SUN_ORBIT_JS__
</script>
<script>
'use strict';
const sc=JSON.parse(document.getElementById('scene').textContent);
const el=id=>document.getElementById(id);
const c=el('map'),screen=c.getContext('2d');
let g=screen;
const homes=sc.buildings.filter(b=>b.is_target).sort((a,b)=>parseInt(a.id)-parseInt(b.id));
const selected={day:'冬至',bid:homes[0].id,unit:'西户',floor:1,frame:0,minute:sc.days['冬至'].start,playing:!matchMedia('(prefers-reduced-motion: reduce)').matches,view:'iso',scope:document.querySelector('[data-scope][aria-pressed="true"]').dataset.scope,speed:1};
const pointByHome=new Map(), allPts=sc.points;
for(let i=0;i<allPts.length;i++){const p=allPts[i];if(!pointByHome.has(p.bid))pointByHome.set(p.bid,new Map());const units=pointByHome.get(p.bid);if(!units.has(p.unit))units.set(p.unit,[]);units.get(p.unit).push(i)}
function addressOf(bid,unit){return allPts[pointByHome.get(bid).get(unit)[0]]}
function addressesFor(bid){return [...pointByHome.get(bid).keys()].map(unit=>addressOf(bid,unit))}
const byId=new Map(sc.buildings.map(b=>[b.id,b]));
const dayList=['大寒','冬至','春分'];
let hitTests=[],sideView='home',exterior=null;
let animationId=0,lastTick=null,lastPanelKey='',lastClockSecond=-1;
const externals=sc.buildings.filter(b=>b.group==='external');
const bridges=externals.filter(b=>b.kind==='bridge');
const bridgeDecks=b=>[b,...(b.parts||[]).filter(part=>part.kind==='deck')];
const orbit=new SunOrbit(sc,c,selected.scope);
const box=c.parentElement;
function placeLayer(canvas,z){
 canvas.className='scene-layer';canvas.setAttribute('aria-hidden','true');canvas.style.zIndex=z;box.append(canvas);
}
placeLayer(orbit.layer,3);
const bearing=document.createElement('canvas');bearing.className='bearing';bearing.setAttribute('aria-hidden','true');box.append(bearing);
const bearingContext=bearing.getContext('2d');
const planCam={x:0,y:0,zoom:1};
const impact=(b)=>Number(b.shadow_impact?.[selected.day]||0);
function inspect(tab){
  sideView=tab;
  el('homePanel').hidden=tab!=='home';el('externalPanel').hidden=tab!=='ext';
  el('homesTab').setAttribute('aria-pressed',String(tab==='home'));el('externalsTab').setAttribute('aria-pressed',String(tab==='ext'));
  if(tab==='ext'){
    if(!exterior)exterior=externals.slice().sort((a,b)=>impact(b)-impact(a))[0]?.id;
    showExterior();
  }
}
let reviewedKey='';
function showExterior(){
  const b=byId.get(exterior);if(!b)return;
  const key=b.id+'|'+selected.day;if(reviewedKey===key)return;reviewedKey=key;
  const proof=b.height_review||{};
  el('external').value=b.id;el('extName').textContent=b.name;el('extId').textContent=b.id;
  const estimated=b.estimated??proof.estimated;
  const limits=Array.isArray(proof.range)?proof.range:b.roof_height_range;
  const bridge=b.kind==='bridge',dimensions=[];
  if(bridge){
    const decks=bridgeDecks(b),piers=(b.parts||[]).filter(p=>p.kind==='pier');
    el('extHeight').textContent='桥面顶标高 '+spanText(decks.map(d=>d.top))+' 米'+(estimated?'（估算）':'');
    dimensions.push('桥面底标高 '+spanText(decks.map(d=>d.base))+' 米','桥面结构厚度 '+spanText(decks.map(d=>d.top-d.base))+' 米');
    dimensions.push(piers.length?'模型含 '+piers.length+' 个桥墩':'模型仅含桥面');
  }else{
    el('extHeight').textContent=(b.base===0?'算阴影采用的屋顶高度 ':'算阴影采用的顶面标高 ')+num(b.top)+' 米'+(estimated?'（估算）':'');
    dimensions.push('模型基底 '+num(b.base)+' m');
    if(b.floors>0)dimensions.push('地上 '+b.floors+' 层');
    if(b.base===0 && Number.isFinite(proof.previous_roof_m) && Math.abs(proof.previous_roof_m-b.top)>.051)dimensions.push('复核前 '+num(proof.previous_roof_m)+' m');
  }
  el('focusExt').textContent=bridge?'聚焦立交桥':'聚焦这栋建筑';
  if(Array.isArray(limits))dimensions.push('高度取值区间 '+limits.map(num).join('–')+' m');
  el('extSpan').textContent=dimensions.join(' · ');
  el('extReview').textContent=[proof.status||'高度待核',proof.summary].filter(Boolean).join(' · ');
  const source=el('extSource');source.replaceChildren();
  const links=[...(proof.references||[]),{url:proof.url,title:proof.source_label}];
  const seen=new Set();
  let more=null;
  for(const ref of links){
    if(!ref?.url || !/^https?:\/\//i.test(ref.url)||seen.has(ref.url))continue;
    if(seen.size===3 && !bridge)break;
    seen.add(ref.url);
    if(seen.size===4){
      more=document.createElement('details');const summary=document.createElement('summary');
      summary.textContent='更多桥位资料';more.append(summary);source.append(more);
    }
    const area=more||source;
    if(seen.size>1 && seen.size!==4)area.append(' · ');
    const a=document.createElement('a');a.href=ref.url;a.textContent=ref.title||'查看资料';
    a.target='_blank';a.rel='noopener noreferrer';area.append(a);
  }
  if(!seen.size && proof.source_label)source.textContent=proof.source_label;
  if(bridge){
    const credit=document.createElement('a');credit.href='https://www.openstreetmap.org/copyright';
    credit.textContent='© OpenStreetMap contributors';credit.target='_blank';credit.rel='noopener noreferrer';
    const creditLine=document.createElement('p');creditLine.append('桥位线数据 ',credit);source.append(creditLine);
  }
  const n=impact(b),object=bridge?'这座桥':'此楼';
  el('extImpact').textContent=b.shadow_impact ?
    (n?selected.day+'从日出到日落，各窗台被'+object+'遮挡的时长合计 '+n.toLocaleString('zh-CN')+' 点·分钟，只计沿射线最靠近窗台的遮挡物。':selected.day+'从日出到日落，'+object+'作为窗台最近遮挡物的合计为 0 点·分钟。'):'';
}
function spanText(values){
  const low=num(Math.min(...values)),high=num(Math.max(...values));
