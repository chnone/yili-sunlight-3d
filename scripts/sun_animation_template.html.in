const layers=new Map();
const layerOrder={ground:0,annotations:4};
function cachedLayer(id,key,paintLayer){
 let slot=layers.get(id);
 if(!slot){
   const canvas=document.createElement('canvas');placeLayer(canvas,layerOrder[id]);
   slot={canvas,ctx:canvas.getContext('2d'),key:null};layers.set(id,slot);
 }
 const {canvas,ctx}=slot;
 if(canvas.hidden)canvas.hidden=false;
 if(slot.key===key)return;
 const dpr=Math.min(2,devicePixelRatio||1);
 const wp=Math.round(c.clientWidth*dpr),hp=Math.round(c.clientHeight*dpr);
 if(canvas.width!==wp||canvas.height!==hp){canvas.width=wp;canvas.height=hp}
 ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,c.clientWidth+1,c.clientHeight+1);
