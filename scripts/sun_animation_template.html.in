}
function pickBuilding(b,unit){
  if(b.group==='external'){exterior=b.id;inspect('ext');draw();return}
  if(!b.is_target)return;
  const prior=addressOf(selected.bid,selected.unit),addresses=addressesFor(b.id);
  const next=addresses.find(a=>a.unit===unit)||addresses.find(a=>a.entry===prior.entry&&a.door===prior.door)||
             addresses.find(a=>a.door===prior.door)||addresses[0];
  inspect('home');Object.assign(selected,{bid:b.id,floor:Math.min(selected.floor,b.floors),unit:next.unit});
  initSelection();
}
function formatTime(minute,seconds=false){
 const total=seconds?Math.round(minute*60):Math.round(minute)*60;
