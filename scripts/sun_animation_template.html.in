const num=v=>Number(v.toFixed(2));
const pt=t=>[t.x,t.y];
function bounds(p){return [Math.min(...p.map(v=>v[0])),Math.min(...p.map(v=>v[1])),Math.max(...p.map(v=>v[0])),Math.max(...p.map(v=>v[1]))]}
const bodies=sc.buildings.flatMap(b=>[b,...(b.parts||[])].map(solid=>({
  owner:b,poly:solid.polygon,lo:solid.base,hi:solid.top,centerline:solid.centerline
})));
const baseB=bounds(sc.site_polygon),allB=bounds(bodies.flatMap(body=>body.poly));
const planBodies=bodies.filter(body=>body.owner.group!=='podium').sort((a,b)=>a.hi-b.hi);
function viewing(w,h){
 if(selected.view==='iso')return orbit.cameraView(w,h);
 const raw=selected.scope==='site'?baseB:allB;
 const s=planCam.zoom*Math.min((w-16)/(raw[2]-raw[0]+24),(h-16)/(raw[3]-raw[1]+28));
 const ox=w/2-s*((raw[0]+raw[2])/2+planCam.x),oy=h/2+s*((raw[1]+raw[3])/2+planCam.y);
