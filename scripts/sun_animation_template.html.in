 if(c.width!==Math.round(w*dpr)||c.height!==Math.round(h*dpr)){c.width=Math.round(w*dpr);c.height=Math.round(h*dpr)}
 g.setTransform(dpr,0,0,dpr,0,0);g.clearRect(0,0,w+1,h+1);
 const {s,P}=viewing(w,h),iso=selected.view==='iso',siteOnly=selected.scope==='site',active=byId.get(selected.bid);
 const ds=sc.days[selected.day],f=sky?.direction?sky:currentSky(ds),dir=f.direction,level=selected.floor,ref=iso?0:active.sill_base+(level-1)*active.floor_height;
 const cam=iso?orbit.camera:planCam;
 const cameraKey=[selected.view,selected.scope,devicePixelRatio,w,h,...Object.values(cam),...(iso?orbit.span:[])].join('|');
 const selectionKey=[cameraKey,selected.day,selected.bid,level,selected.unit,sideView,exterior].join('|');
 cachedLayer('ground',cameraKey,()=>{
 g.fillStyle='#e9eeea';g.fillRect(0,0,w,h);
 for(let x=Math.floor(allB[0]/25)*25;x<=allB[2]+80;x+=25)line(P(x,allB[1]-100),P(x,allB[3]+140),'#dae2df',.6);
 for(let y=Math.floor((allB[1]-100)/25)*25;y<=allB[3]+140;y+=25)line(P(allB[0]-100,y),P(allB[2]+100,y),'#dae2df',.6);
 // Road positions are map annotations from the planning sheet.
 for(const [a,b,width] of [[[-6,-160],[-6,235],8],[[230,-160],[230,235],23],[[-220,-12],[525,-12],13],[[-220,125],[525,125],19]]){
   line(P(...a),P(...b),'#cdd7d3',(width+.8)*s);line(P(...a),P(...b),'#f6f7f3',width*s)
 }
 const extents=pathPoly(sc.site_polygon,P);
 paint(extents,'#f7f5e9','#6a817d',1);
 if(iso&&(w>=580||siteOnly)){
     for(const [name,x,y,dx,dy] of [['嘉江道',108,126,1,0],['沐江道',112,-13,1,0],['太湖路',230,56,0,1],['墨江道',-6,53,0,1]]){
       const a=P(x,y),b=P(x+dx,y+dy);let angle=Math.atan2(b[1]-a[1],b[0]-a[0]);
       if(angle>Math.PI/2)angle-=Math.PI;else if(angle< -Math.PI/2)angle+=Math.PI;
       g.save();g.translate(...a);g.rotate(angle);textAt(name,0,0,siteOnly?11:9,'#526860','center',false,true);g.restore();
     }
 }
 });
 const shadowKey=cameraKey+'|'+ref;
 if(shadowCache.key!==shadowKey)shadowCache={key:shadowKey,model:shadowGeometry(ref,P,w,h)};
 // Low-angle sunlight emerges gradually from a diffuse dawn/dusk background.
 const lowSun=Math.min(1,Math.max(0,f.altitude/2.5));
 const daylightTone=lowSun*lowSun*(3-2*lowSun);
 if(daylightTone<1){g.fillStyle='rgba(93,111,137,'+(.14*(1-daylightTone))+')';g.fillRect(0,0,w,h)}
 if(daylightTone>0)paint(shadowPath(shadowCache.model,dir),'rgba(83,108,115,'+(.35*daylightTone)+')');
 function pointsFor(b){
  if(!b.is_target||level>b.floors)return;
  for(const [unit,ids] of pointByHome.get(b.id)){
    const isChosen=b.id===active.id&&unit===selected.unit;
    const height=iso?b.sill_base+(level-1)*b.floor_height:0;
    const coords=ids.map(i=>P(...pt(allPts[i]),height));
    const visible=ids.map(i=>!iso || orbit.visible(allPts[i].x,allPts[i].y,height,b.id));
    if(isChosen)for(let j=1;j<coords.length;j++)if(visible[j-1]&&visible[j])line(coords[j-1],coords[j],'#ffdc91',Math.max(1.3,s*.65));
    ids.forEach((ip,k)=>{if(!visible[k])return;const [x,y]=coords[k],direct=lit(f.masks[ip],level);
      const rad=(isChosen?1.2:0)+Math.max(1.6,Math.min(3.8,s*1.05));
      g.beginPath();g.arc(x,y,rad,0,7);g.fillStyle=direct?'#ffc35d':'#324551';g.fill();
      g.strokeStyle=isChosen?'#9a4720':direct?'#77551f':'#edf4ef';g.lineWidth=isChosen?1.65:1;g.stroke();
      markerHits.push({x,y,r:rad+4,bid:b.id,unit});
    });
    if(isChosen){
      const meanX=coords.reduce((total,p)=>total+p[0],0)/coords.length;
      ids.forEach((ip,k)=>{
        if(!visible[k])return;const [x,y]=coords[k],dx=Math.sign(x-meanX)*4;
        line([x,y+4],[x+dx,y+8],'#805c35',.8);
        textAt(allPts[ip].label,x+dx,y+12,9,'#5c3a1e','center',true,true);
      });
    }
  }
 }
 const labelBoxes=[];
 function labelBuilding(b){
   if(b.group==='podium')return;
   const bridge=b.kind==='bridge',active=b.id===selected.bid || (sideView==='ext'&&b.id===exterior);
   let mid=null,distance=Infinity;
   for(const solid of bridge?bridgeDecks(b):[b]){
     const bb=bounds(solid.polygon),z=iso?solid.top:0;
     const axis=solid.centerline;
     const candidates=axis?.length>=2?axis.slice(1).map((p,i)=>[(p[0]+axis[i][0])/2,(p[1]+axis[i][1])/2]):[[(bb[0]+bb[2])/2,(bb[1]+bb[3])/2]];
     for(const [x,y] of candidates){
       const screenPos=P(x,y,z),[sx,sy]=screenPos;
       if(sx<10||sx>w-10||sy<12||sy>h-12)continue;
       if(iso && (!orbit.visible(x,y,z,b.id)||(bridge&&orbit.hit(sx,sy)!==b)))continue;
       const d=Math.hypot(sx-w/2,sy-h/2);
       if(d<distance){mid=screenPos;distance=d}
     }
   }
   if(!mid)return;
   const code=bridge?(b.name.length<=10?b.name:'立交桥'):b.is_target?String(parseInt(b.id))+'#':b.id.replace('外','');
   const font=Math.max(bridge?10:b.is_target?9:8,Math.min(13,s*3.4));
   const hw=font*code.length*(bridge ? .5 : .31)+2,hh=font*.55;
   if(labelBoxes.some(([x,y,dx,dy])=>Math.abs(x-mid[0])<dx+hw && Math.abs(y-mid[1])<dy+hh))return;
   labelBoxes.push([mid[0],mid[1],hw,hh]);
   textAt(code,mid[0],mid[1],font,bridge?'#343d61':active?'#fff':b.is_target?'#143f4b':'#473f34','center',true,bridge||!active);
 }
 function bodyColors(b){
   if(b.kind==='bridge')return sideView==='ext'&&b.id===exterior?['#555080','#383957']:['#646e89','#4c566d'];
   if(sideView==='ext'&&b.id===exterior)return ['#ac5934','#713d2e'];
   if(b.group==='external')return impact(b)?['#c19a79','#795e49']:['#b4beb9','#818f8a'];
   if(b.id===active.id)return ['#37697b','#153f53'];
   if(b.floors<level)return ['#e5e9e5','#b5c1be'];
   return [b.phase?.includes('后续')?'#bed0cd':'#a5bec1','#647f84'];
 }
 function drawBridgeAxis(body){
   if(body.owner.kind!=='bridge' || !body.centerline?.length)return;
   // This schematic axis follows the deck. Skip samples hidden behind solids.
   const path=new Path2D(),axis=body.centerline,z=iso?body.hi:0;
   for(let i=1;i<axis.length;i++){
     const [x,y]=axis[i-1],dx=axis[i][0]-x,dy=axis[i][1]-y;
     const a=P(x,y,z),b=P(x+dx,y+dy,z);
     if(Math.max(a[0],b[0])<0||Math.min(a[0],b[0])>w||Math.max(a[1],b[1])<0||Math.min(a[1],b[1])>h)continue;
     if(!iso){path.moveTo(...a);path.lineTo(...b);continue}
     const steps=Math.max(1,Math.ceil(Math.hypot(a[0]-b[0],a[1]-b[1])/2));
     let previousVisible=false;
     for(let j=0;j<=steps;j++){
       const t=j/steps,px=x+t*dx,py=y+t*dy,pos=P(px,py,z);
       const visible=orbit.hit(...pos)===body.owner&&orbit.visible(px,py,z,body.owner.id);
       if(visible){if(previousVisible)path.lineTo(...pos);else path.moveTo(...pos)}
       previousVisible=visible;
     }
   }
   g.save();g.strokeStyle='#e5e5d7';g.lineWidth=Math.max(.65,Math.min(2,s*.24));
   g.setLineDash([Math.max(2,s*3),Math.max(2,s*4)]);g.stroke(path);g.restore();
 }
 if(orbit.layer.hidden!==!iso)orbit.layer.hidden=!iso;
 if(iso)orbit.draw(null,f,selected,sideView==='ext'?exterior:null,b=>impact(b)>0);
 const overlayKey=selectionKey+'|'+selected.frame+'|'+(iso?orbit.pixelRatio:0);
 cachedLayer('annotations',overlayKey,()=>{
   if(!iso){
   planHits=[];
   for(const body of planBodies){
     const b=body.owner,path=pathPoly(body.poly,P),[fill,stroke]=bodyColors(b);
     paint(path,fill,stroke,b.id===active.id?1.6:.85);
     drawBridgeAxis(body);
     planHits.push({path,bid:b.id});
   }
   }else bodies.filter(body=>body.owner.kind==='bridge').forEach(drawBridgeAxis);
 const labels=[byId.get(selected.bid),...(sideView==='ext'?[byId.get(exterior)]:[]),...homes,...bridges,...externals];
 [...new Set(labels.filter(Boolean))].forEach(labelBuilding);
 if(!iso){
   for (const [name,x,y,rot] of [['嘉江道',110,125,0],['沐江道',110,-12,0],['太湖路',230,54,-Math.PI/2],['墨江道',-6,54,-Math.PI/2]]){
     const t=P(x,y);g.save();g.translate(...t);g.rotate(rot);textAt(name,0,0,siteOnly&&w>400?10:8,'#627a77','center',false,true);g.restore();
   }
 }
 // Scale and sun bearing in horizontal EN. The bearing arrow points to the sun.
 const desiredMeters=68/s, power=10**Math.floor(Math.log10(desiredMeters));
 const meters=[1,2,5,10].map(step=>step*power).reduce((a,b)=>Math.abs(a-desiredMeters)<Math.abs(b-desiredMeters)?a:b),bar=meters*s;
 g.fillStyle='#ffffffdf';g.fillRect(10,h-32,Math.max(68,bar+17),25);line([18,h-13],[18+bar,h-13],'#37555d',1.3);
 line([18,h-13],[18,h-17],'#37555d',1.3);line([18+bar,h-13],[18+bar,h-17],'#37555d',1.3);textAt(Number(meters.toPrecision(3))+' m',18,h-24,9,'#37555d','left');
 const origin=P(0,0),np=P(0,1),na=Math.atan2(np[1]-origin[1],np[0]-origin[0])*180/Math.PI+90;
 el('north').setAttribute('transform','rotate('+na+' 8 13)');
 el('planeNote').textContent=iso?'三维楼群 · 米制等比例':'窗台高度水平面投影 · '+num(ref)+' m';
   markerHits=[];homes.forEach(pointsFor);hitTests=iso?markerHits:[...planHits,...markerHits];
 });
 const bearingDpr=Math.min(2,devicePixelRatio||1);
 if(bearing.width!==Math.round(72*bearingDpr)||bearing.height!==Math.round(64*bearingDpr)){
   bearing.width=Math.round(72*bearingDpr);bearing.height=Math.round(64*bearingDpr);
 }
 g=bearingContext;g.setTransform(bearingDpr,0,0,bearingDpr,0,0);g.clearRect(0,0,72,64);
 const origin=P(0,0),sunP=P(dir[0],dir[1]),vx=sunP[0]-origin[0],vy=sunP[1]-origin[1],length=Math.hypot(vx,vy);
 const u=vx/length,v=vy/length, tx=39,ty=34;
 g.fillStyle='#ffffffdb';g.beginPath();g.arc(tx,ty,26,0,7);g.fill();g.lineWidth=.8;g.strokeStyle='#c3cfca';g.stroke();
 line([tx-8*u,ty-8*v],[tx+13*u,ty+13*v],'#98580d',1.7);g.fillStyle='#f1ad37';g.beginPath();g.arc(tx+13*u,ty+13*v,4.5,0,7);g.fill();g.strokeStyle='#8e621c';g.stroke();
 textAt('太阳',tx,ty+17,8,'#704e19');g=screen;
}
function updateBlocker(entry,day,ip,on){
 const box=entry.querySelector('.blocker'),events=day.blockers?.[ip]?.[selected.floor-1];
 // Each entry takes effect at its first frame and lasts until the next one.
 box.hidden=on || !events?.length;if(box.hidden)return;
 let lo=0,hi=events.length;
 while(lo<hi){const mid=(lo+hi)>>1;if(events[mid][0]<=selected.frame)lo=mid+1;else hi=mid}
 const id=lo?events[lo-1][1]:-1,b=sc.buildings[id];
 const description=box.querySelector('span'),link=box.querySelector('button');
 link.hidden=b?.group!=='external';
 if(!link.hidden) {
   description.textContent='最近遮挡';link.dataset.id=b.id;
   link.textContent=b.kind==='bridge'?b.name:b.id+' · '+b.name;link.title='查看遮挡物的高度与来源';
 }else if(b){
   description.textContent='最近遮挡　'+b.id+(b.id===selected.bid?'（本楼）':'');
 }else if(id===-2){description.textContent='窗面背阳或太阳低于地平线'}
 else{box.hidden=true}
}
function redraw(){
 const day=sc.days[selected.day];
 selected.frame=preceding(day.frames,selected.minute,f=>f.start);
 const frame=day.frames[selected.frame],sky=currentSky(day);
 draw(sky);
 const key=[selected.day,selected.frame,selected.bid,selected.unit,selected.floor].join('|');
 const binChanged=key!==lastPanelKey;
 if(binChanged){
   el('sampleTime').textContent='窗台采样区间 '+formatTime(frame.start,true)+'–'+formatTime(frame.end,true);
   lastPanelKey=key;
 }
 const second=Math.round(selected.minute*60);
 if(second!==lastClockSecond || binChanged){
   const clock=formatTime(selected.minute,true);
   el('clock').textContent=clock;el('scrub').setAttribute('aria-valuetext',clock+' 北京时间');
   el('alt').textContent=sky.altitude.toFixed(1)+'°';el('az').textContent=sky.azimuth.toFixed(1)+'°';
   el('until').textContent='累计至 '+clock.slice(0,5);
   lastClockSecond=second;
 }
 el('scrub').value=selected.minute;
 for(const entry of el('probes').children){
   const ip=Number(entry.dataset.ip),on=lit(frame.masks[ip],selected.floor);
   if(binChanged){
     const status=entry.querySelector('.status');status.textContent=on?'见光':'受遮';status.className='status '+(on?'on':'off');
     updateBlocker(entry,day,ip,on);
   }
   const total=sample(ip,selected.floor).prefix[selected.frame]+(on?selected.minute-frame.start:0);
   const sum=entry.querySelector('.sum'),text=durationText(total);
   if(sum.textContent!==text)sum.textContent=text;
   entry.querySelector('.cursor').style.left=(selected.minute-day.start)*100/(day.end-day.start)+'%';
 }
 if(binChanged && sideView==='ext')showExterior();
}
function refreshPlayback(){
 const button=el('play');
 button.innerHTML=selected.playing?'<span class="icon">Ⅱ</span>暂停':'<span class="icon">▶</span>播放';
 button.setAttribute('aria-label',selected.playing?'暂停动画':'播放动画');
}
const minutesPerSecond=8;
function animate(timestamp){
 animationId=0;
 if(document.hidden)return;
 if(selected.playing){
   const day=sc.days[selected.day];
   if(lastTick!==null)selected.minute=Math.min(day.end,selected.minute+(timestamp-lastTick)*.001*minutesPerSecond*selected.speed);
   lastTick=timestamp;
   if(selected.minute>=day.end){selected.playing=false;lastTick=null;refreshPlayback()}
 }
 redraw();
 if(selected.playing)requestDraw();
}
function requestDraw(){
 if(!animationId&&!document.hidden)animationId=requestAnimationFrame(animate);
}
function restartClock(){
 lastTick=null;
 if(animationId)cancelAnimationFrame(animationId);
 animationId=0;
 if(!document.hidden)requestDraw();
}
function seek(minute){
 const day=sc.days[selected.day];selected.playing=false;
 selected.minute=Math.max(day.start,Math.min(minute,day.end));
 refreshPlayback();restartClock();
}
el('play').onclick=()=>{
 const day=sc.days[selected.day];
 if(!selected.playing&&selected.minute>=day.end)selected.minute=day.start;
 selected.playing=!selected.playing;refreshPlayback();restartClock();
};
el('speed').onchange=e=>{selected.speed=Number(e.target.value);restartClock()};
el('scrub').oninput=e=>seek(Number(e.target.value));
el('scrub').onkeydown=e=>{
 const day=sc.days[selected.day],step=e.shiftKey?5:1;
 const next={ArrowLeft:selected.minute-step,ArrowDown:selected.minute-step,ArrowRight:selected.minute+step,
   ArrowUp:selected.minute+step,Home:day.start,End:day.end,PageDown:selected.minute-30,PageUp:selected.minute+30}[e.key];
 if(next!==undefined){e.preventDefault();seek(next)}
};
el('house').onchange=e=>pickBuilding(byId.get(e.target.value));
el('floor').onchange=e=>{selected.floor=Number(e.target.value);initSelection()};
el('entry').onchange=e=>{
 const doors=addressesFor(selected.bid).filter(a=>a.entry===e.target.value);
 const previous=addressOf(selected.bid,selected.unit).door;
 selected.unit=(doors.find(a=>a.door===previous)||doors[0]).unit;initSelection();
};
el('unit').onchange=e=>{selected.unit=e.target.value;initSelection()};
function resetView(){
 orbit.reset(selected.scope);Object.assign(planCam,{x:0,y:0,zoom:1});
 el('mapHint').textContent=selected.view==='iso'?'拖动旋转 · 滚轮缩放 · 右键或 Shift 拖动平移 · 触屏双指缩放和平移':'拖动平移 · 滚轮或双指缩放';
 draw();
}
function changeZoom(factor,anchor){
 const camera=selected.view==='iso'?orbit.camera:planCam,old=camera.zoom;
 if(selected.view==='iso')orbit.zoom(factor);else planCam.zoom=Math.max(.1,Math.min(30,planCam.zoom*factor));
 if(anchor){const correction=1-camera.zoom/old;panBy((anchor.x-c.clientWidth/2)*correction,(anchor.y-c.clientHeight/2)*correction)}
}
function zoomBy(factor,anchor){changeZoom(factor,anchor);requestDraw()}
function panBy(dx,dy){
 if(selected.view==='iso')orbit.pan(dx,dy);
 else{const {s}=viewing(c.clientWidth,c.clientHeight);planCam.x-=dx/s;planCam.y+=dy/s}
}
for(const key of ['view','scope'])document.querySelectorAll('[data-'+key+']').forEach(b=>b.onclick=()=>{
 selected[key]=b.dataset[key];toggleGroup('[data-'+key+']',key,selected[key]);resetView();
});
el('resetCam').onclick=resetView;el('zoomIn').onclick=()=>zoomBy(1.35);el('zoomOut').onclick=()=>zoomBy(1/1.35);
el('homesTab').onclick=()=>{inspect('home');draw()};el('externalsTab').onclick=()=>{inspect('ext');draw()};
el('external').onchange=e=>{exterior=e.target.value;inspect('ext');draw()};
function focusBuilding(b){
 if(!b)return;
 if(selected.view!=='iso'){selected.view='iso';toggleGroup('[data-view]','view','iso');resetView()}
 orbit.focus(b);draw();
}
el('focusHome').onclick=()=>focusBuilding(byId.get(selected.bid));el('focusExt').onclick=()=>focusBuilding(byId.get(exterior));
function hitAt(x,y){
 g.save();g.setTransform(1,0,0,1,0,0);let found=null;
 for(let n=hitTests.length-1;n>=0;n--){const t=hitTests[n];if(t.path?g.isPointInPath(t.path,x,y):Math.hypot(x-t.x,y-t.y)<=t.r){found={b:byId.get(t.bid),unit:t.unit};break}}
 g.restore();
 if(!found&&selected.view==='iso'){const b=orbit.hit(x,y);if(b)found={b}}
 return found;
}
const pointers=new Map();let gesture=null;
const local=e=>{const r=c.getBoundingClientRect();return {x:e.clientX-r.left,y:e.clientY-r.top}};
c.oncontextmenu=e=>e.preventDefault();
c.onpointerdown=e=>{
 if(e.button>2)return;
 const pos=local(e);pointers.set(e.pointerId,pos);c.setPointerCapture(e.pointerId);
 if(pointers.size===1)gesture={origin:pos,pan:e.button!==0||e.shiftKey,moved:false};
 else gesture.moved=true;
 el('hover').hidden=true;c.classList.add('dragging');
};
c.onpointermove=e=>{
 const next=local(e),last=pointers.get(e.pointerId);
 if(!last){
   if(e.pointerType==='mouse'){
     const target=hitAt(next.x,next.y),tooltip=el('hover');
     tooltip.hidden=!target||target.b.group==='podium';
     if(!tooltip.hidden){
       const b=target.b;
       tooltip.textContent=b.kind==='bridge'?b.name+' · 桥面 '+spanText(bridgeDecks(b).map(d=>d.top))+' m'+(b.estimated?'（估算）':''):b.name+' · 顶面 '+num(b.top)+' m';
       tooltip.style.left=Math.max(2,Math.min(next.x+12,c.clientWidth-tooltip.offsetWidth-4))+'px';
       tooltip.style.top=Math.max(2,Math.min(next.y+12,c.clientHeight-tooltip.offsetHeight-4))+'px';
     }
   }return;
 }
 const dx=next.x-last.x,dy=next.y-last.y;
 if(pointers.size===1){
   if(Math.hypot(next.x-gesture.origin.x,next.y-gesture.origin.y)>4)gesture.moved=true;
   if(gesture.moved){
     if(selected.view==='iso'&&!gesture.pan&&!e.shiftKey)orbit.orbit(dx,dy);else panBy(dx,dy);
   }
 }else if(pointers.size===2){
   const other=[...pointers.entries()].find(([id])=>id!==e.pointerId)[1];
   const before=Math.hypot(last.x-other.x,last.y-other.y),after=Math.hypot(next.x-other.x,next.y-other.y);
   if(before>6&&after>6){
     changeZoom(after/before,{x:(last.x+other.x)/2,y:(last.y+other.y)/2});
     panBy(dx/2,dy/2);
   }
 }
 pointers.set(e.pointerId,next);if(gesture.moved)requestDraw();
};
function finishPointer(e,cancelled){
 if(!pointers.has(e.pointerId))return;
 const pos=local(e);pointers.delete(e.pointerId);
 if(!pointers.size){
   if(!cancelled&&!gesture.moved&&e.button===0){const t=hitAt(pos.x,pos.y);if(t)pickBuilding(t.b,t.unit)}
   gesture=null;c.classList.remove('dragging');requestDraw();
 }
}
c.onpointerup=e=>finishPointer(e,false);c.onpointercancel=e=>finishPointer(e,true);
c.onlostpointercapture=e=>finishPointer(e,true);c.onpointerleave=()=>{el('hover').hidden=true};
c.addEventListener('wheel',e=>{e.preventDefault();const mult=e.deltaMode===1?16:e.deltaMode===2?c.clientHeight:1;zoomBy(Math.exp(Math.max(-1,Math.min(1,-e.deltaY*mult*.0015))),local(e))},{passive:false});
c.onkeydown=e=>{
 const d={ArrowLeft:[-10,0],ArrowRight:[10,0],ArrowUp:[0,-10],ArrowDown:[0,10]}[e.key];
 if(d){if(selected.view==='iso'&&!e.shiftKey)orbit.orbit(...d);else panBy(...d);draw()}
 else if(['+','='].includes(e.key))zoomBy(1.25);else if(e.key==='-')zoomBy(.8);else if(e.key==='Home')resetView();else return;
 e.preventDefault();
};
for(const day of dayList){const b=document.createElement('button');b.dataset.day=day;b.textContent=day;b.onclick=()=>{selected.day=day;selected.minute=sc.days[day].start;selected.frame=0;initSelection();restartClock()};el('dayTabs').append(b)}
options(el('house'),homes,b=>b.id,b=>b.id);
options(el('external'),externals,b=>b.id,b=>b.id+' · '+b.name);
el('externalsTab').textContent=bridges.length?'周边楼与桥':'周边楼高 '+externals.length;
if(bridges.length){
  const link=el('bridgeLink');link.hidden=false;
  link.onclick=()=>{
    exterior=bridges[0].id;inspect('ext');
    selected.scope='all';toggleGroup('[data-scope]','scope','all');
    focusBuilding(bridges[0]);
  };
}
el('mapHint').textContent='拖动旋转 · 滚轮缩放 · 右键或 Shift 拖动平移 · 触屏双指缩放和平移';
new ResizeObserver(requestDraw).observe(c);document.addEventListener('visibilitychange',restartClock);
initSelection();refreshPlayback();restartClock();
</script></body></html>
