function currentSky(day){
 const minute=selected.minute,path=day.solar_path;
 const i=preceding(path,minute,k=>k.minute),a=path[i],b=path[Math.min(i+1,path.length-1)];
 const t=b.minute>a.minute?(minute-a.minute)/(b.minute-a.minute):0;
