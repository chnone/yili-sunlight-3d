   azimuth:(Math.atan2(direction[0],direction[1])*180/Math.PI+360)%360,
   masks:day.frames[selected.frame].masks};
}
function options(select,values,key,label){select.replaceChildren(...values.map(v=>new Option(label(v),key(v))))}
function toggleGroup(query,name,state){document.querySelectorAll(query).forEach(b=>b.setAttribute('aria-pressed',String(b.dataset[name]===state)))}
function lit(mask,k){return typeof mask==='string' ? (BigInt(mask)&(1n<<BigInt(k-1)))!==0n : Math.floor(mask/2**(k-1))%2===1}
const runtimeSamples=new Map();
function sample(ip,k){
 const key=[selected.day,ip,k].join('|');if(runtimeSamples.has(key))return runtimeSamples.get(key);
 const ds=sc.days[selected.day];let count=0,runs=[],prefix=[];
 ds.frames.forEach((f,i)=>{prefix[i]=count;if(lit(f.masks[ip],k)){count+=f.end-f.start;if(runs.length&&runs.at(-1)[1]===f.start)runs.at(-1)[1]=f.end;else runs.push([f.start,f.end])}});
 const record={count,runs,prefix};runtimeSamples.set(key,record);return record;
}
function makeCards(){
 const ds=sc.days[selected.day],ids=pointByHome.get(selected.bid).get(selected.unit);
 el('probes').replaceChildren(...ids.map(ip=>{
   const entry=sample(ip,selected.floor),node=document.createElement('section');node.className='probe';node.dataset.ip=ip;
   node.innerHTML='<div class="probe-title"><strong></strong><span class="status"></span></div><div class="blocker" hidden><span></span><button type="button" hidden></button></div><div class="duration"><span>已累计 <b class="sum"></b></span><span>全天 <b class="total"></b></span></div><div class="track"></div><div class="timescale"><span></span><span></span></div><p class="periods"></p>';
   const blockerButton=node.querySelector('.blocker button');
   blockerButton.onclick=()=>{if(blockerButton.dataset.id){exterior=blockerButton.dataset.id;inspect('ext');draw()}};
   const relative=ids.length===2?(allPts[ip].x>allPts[ids.find(j=>j!==ip)].x?' · 偏东':' · 偏西'):'';
   node.querySelector('strong').textContent=allPts[ip].label+' 点'+relative;node.querySelector('.total').textContent=durationText(entry.count);
   const tr=node.querySelector('.track');entry.runs.forEach(([a,b])=>{let s=document.createElement('span');s.className='lit';s.style.left=(a-ds.start)*100/(ds.end-ds.start)+'%';s.style.width=(b-a)*100/(ds.end-ds.start)+'%';tr.append(s)});let cursor=document.createElement('i');cursor.className='cursor';tr.append(cursor);
   const ticks=node.querySelector('.timescale').children;ticks[0].textContent=formatTime(ds.start);ticks[1].textContent=formatTime(ds.end);
   node.querySelector('.periods').textContent=entry.runs.length?'见光 '+entry.runs.map(r=>r.map(t=>formatTime(t)).join('–')).join(' / '):'本时段无直射';
   return node;
 }));
}
let rankingDay=null,rankExpanded=false;
function rankDuration(seconds){
 const minutes=Math.round(seconds/60),hours=Math.floor(minutes/60);
 return (hours?hours+' 小时 ':'')+(minutes%60)+' 分';
}
function floorText(floors){
 const ranges=[];
 for(const floor of [...new Set(floors)].sort((a,b)=>a-b)){
   const tail=ranges.at(-1);
   if(tail&&floor===tail[1]+1)tail[1]=floor;
   else ranges.push([floor,floor]);
 }
 return ranges.map(([a,b])=>a===b?String(a):a+'–'+b).join('、')+'层';
}
function describeHomes(rows){
 const buildings=new Map();
 for(const {bid,unit,floor} of rows){
   if(!buildings.has(bid))buildings.set(bid,new Map());
   const units=buildings.get(bid);
   if(!units.has(unit))units.set(unit,[]);
   units.get(unit).push(floor);
 }
 const descriptions=[];
 for(const [bid,units] of buildings){
   const byFloor=new Map();
   for(const [unit,floors] of units){
     const label=floorText(floors);
     if(!byFloor.has(label))byFloor.set(label,[]);
     byFloor.get(label).push(unit);
   }
   const levels=[];
   for(const [level,names] of byFloor){
     const doorsByEntry=new Map();
     for(const name of names){
       const {entry,door}=addressOf(bid,name);
       if(!doorsByEntry.has(entry))doorsByEntry.set(entry,[]);
       doorsByEntry.get(entry).push(door);
     }
     const addresses=[...doorsByEntry].map(([entry,doors])=>(entry?entry+'的':'')+doors.join('、'));
     levels.push(level+' '+addresses.join('及'));
   }
   descriptions.push(bid+' '+levels.join('，'));
 }
 return descriptions.join('，');
}
function renderRanks(){
 const day=selected.day,{households,rows}=sc.days[day].household_leaders;
 const leaders=rows.filter(r=>r.rank===1);
 const firstPhase=leaders.filter(r=>byId.get(r.bid).phase==='一期申报');
 el('rankSummary').textContent=day+'的 '+households+' 户中，'+leaders.length+' 户'+(leaders.length>1?'并列':'排名')+'第一，平均日照约 '+rankDuration(leaders[0].mean_seconds)+'。';
 el('rankHomes').textContent=firstPhase.length?'其中 '+firstPhase.length+' 户在一期申报楼栋，分别是 '+describeHomes(firstPhase)+'。':'日照最长的住户为 '+describeHomes(leaders)+'。';

 // Show a representative from each building at the same rank before repeating
 // a building. Expanding restores the original building/floor/household order.
 const preview=[];
 for(const rank of new Set(rows.map(r=>r.rank))){
   const tied=rows.filter(r=>r.rank===rank);
   const first=[],rest=[],seen=new Set();
   for(const r of tied){
     if(seen.has(r.bid))rest.push(r);
     else{first.push(r);seen.add(r.bid)}
   }
   preview.push(...first,...rest);
 }
 const visible=rankExpanded?rows:preview.slice(0,5);
 const rankCounts=new Map();
 for(const row of rows)rankCounts.set(row.rank,(rankCounts.get(row.rank)||0)+1);
 el('rankList').replaceChildren(...visible.map(row=>{
   const item=document.createElement('li'),button=document.createElement('button');
   button.type='button';button.className='rank-home';
   const {entry,door}=addressOf(row.bid,row.unit);
   Object.assign(button.dataset,{bid:row.bid,floor:row.floor,unit:row.unit,entry,door});
   button.innerHTML='<span class="rank-number"></span><span><strong class="rank-address"></strong><small class="rank-phase"></small></span><span><strong class="rank-duration"></strong><small class="rank-probes"></small></span>';
   button.querySelector('.rank-number').textContent=(rankCounts.get(row.rank)>1?'并列第':'第')+row.rank;
   button.querySelector('.rank-address').textContent=[row.bid,row.floor+'层',entry,door].filter(Boolean).join(' · ');
   button.querySelector('.rank-phase').textContent=byId.get(row.bid).phase;
   button.querySelector('.rank-duration').textContent='约 '+rankDuration(row.mean_seconds);
   button.querySelector('.rank-probes').textContent=Object.entries(row.probe_seconds).map(([label,s])=>label+' '+durationText(s/60)).join(' · ');
   item.append(button);return item;
 }));
 const more=el('rankMore');
 more.hidden=rows.length<=5;more.textContent=rankExpanded?'收起列表':'展开全部 '+rows.length+' 户';
 more.setAttribute('aria-expanded',String(rankExpanded));
 markRankSelection();
}
function markRankSelection(){
 for(const button of el('rankList').querySelectorAll('button')){
   const {bid,floor,unit}=button.dataset;
   button.setAttribute('aria-pressed',String(bid===selected.bid&&Number(floor)===selected.floor&&unit===selected.unit));
 }
}
el('rankMore').onclick=()=>{rankExpanded=!rankExpanded;renderRanks()};
el('rankList').onclick=e=>{
 const button=e.target.closest('button[data-bid]');if(!button)return;
 const {bid,floor,unit}=button.dataset;
 inspect('home');Object.assign(selected,{bid,floor:Number(floor),unit});
 initSelection();focusBuilding(byId.get(bid));
 document.querySelector('.map-head').scrollIntoView({block:'start'});c.focus({preventScroll:true});
};
function initSelection(){
 const b=byId.get(selected.bid);
 const addresses=addressesFor(b.id),active=addresses.find(a=>a.unit===selected.unit)||addresses[0];
 selected.unit=active.unit;
 const entries=[...new Set(addresses.map(a=>a.entry))];
 options(el('entry'),entries,e=>e,e=>e||'单元待核');el('entry').value=active.entry;
 el('entry').disabled=entries.length===1;
 options(el('unit'),addresses.filter(a=>a.entry===active.entry),a=>a.unit,a=>a.door);
 el('unit').value=active.unit;
 if(el('floor').length!==b.floors){
   options(el('floor'),Array.from({length:b.floors},(_,i)=>i+1),v=>v,v=>v+' 层');
 }
 el('floor').value=String(selected.floor);el('house').value=selected.bid;
 el('homeMeta').textContent=(b.phase||'住宅')+' · '+b.floors+' 个住宅层 · 模型顶面标高 '+num(b.top)+' m';
 const ds=sc.days[selected.day],scrub=el('scrub');scrub.min=ds.start;scrub.max=ds.end;
 const tickMinutes=[ds.start,...[540,720,900].filter(t=>t-ds.start>58&&ds.end-t>58),ds.end];
 el('ticks').replaceChildren(...tickMinutes.map(t=>{
   const label=document.createElement('span'),first=t===ds.start,last=t===ds.end;
   label.style.left=100*(t-ds.start)/(ds.end-ds.start)+'%';label.className=first?'first':last?'last':t===720?'noon':'intermediate';
   label.textContent=(first?'日出 ':last?'日落 ':'')+formatTime(t);
   label.title=formatTime(t,true)+' 北京时间';return label;
 }));
 el('subtitle').textContent='天津河西 · '+ds.date+' · '+selected.day+' · 南向窗台直射';
 if(rankingDay!==selected.day){rankingDay=selected.day;rankExpanded=false;renderRanks()}
 else markRankSelection();
 toggleGroup('[data-day]','day',selected.day);makeCards();lastPanelKey='';lastClockSecond=-1;redraw();
