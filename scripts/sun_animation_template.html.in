// Cache geometry in screen space while the camera and analysis plane are fixed.
// Only the exposed outward edges need sweeping to project each prismatic solid.
function shadowGeometry(z,P,w,h){
 const center=[w/2,h/2],diagonal=Math.hypot(w,h)/2;
 const faces=[];
 for(const {poly,lo,hi} of bodies){
   if(hi<=z)continue;
   const ring=poly.map(([x,y])=>P(x,y,z));
   if(twiceArea(ring)<0)ring.reverse();
   const reach=diagonal+Math.max(...ring.map(([x,y])=>Math.hypot(x-center[0],y-center[1])))+2;
