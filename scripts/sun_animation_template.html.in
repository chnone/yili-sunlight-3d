function shadowPath(model,dir){
 const path=new Path2D();
 if(dir[2]<=0)return path;
 const dx=-(model.xx*dir[0]+model.yx*dir[1])/dir[2],dy=-(model.xy*dir[0]+model.yy*dir[1])/dir[2];
 const shift=Math.hypot(dx,dy);
 for(const {ring,reach,lo,hi} of model.faces){
   if(lo*shift>reach)continue;
   // Beyond reach both cap and outgoing edge are off screen, even at sunrise.
   const high=shift?Math.min(hi,reach/shift):hi;
   const bx=dx*lo,by=dy*lo,tx=dx*high,ty=dy*high;
   path.moveTo(ring[0][0]+bx,ring[0][1]+by);
   for(let k=1;k<ring.length;k++)path.lineTo(ring[k][0]+bx,ring[k][1]+by);
   path.closePath();
   let a=ring[ring.length-1];
   for(const b of ring){
     if((b[0]-a[0])*dy-(b[1]-a[1])*dx<0){
       path.moveTo(a[0]+bx,a[1]+by);path.lineTo(a[0]+tx,a[1]+ty);
       path.lineTo(b[0]+tx,b[1]+ty);path.lineTo(b[0]+bx,b[1]+by);path.closePath();
